{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cafeepr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "secrets": {
    "required": [
      "SUPABASE_SERVICE_ROLE_KEY"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
