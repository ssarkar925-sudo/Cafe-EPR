{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cafeerp",
  "main": "./custom-worker.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "30 2 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
