 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3.5 w-3.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div><p class=\"text-sm font-semibold text-slate-200\">Billing &amp; Ledger</p><p class=\"text-xs text-slate-500\">Customer balances, cash book, expenses</p></div></li><li class=\"flex items-start gap-3\"><span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3.5 w-3.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div><p class=\"text-sm font-semibold text-slate-200\">AEPS / DMT / UPI</p><p class=\"text-xs text-slate-500\">Business transactions &amp; settlements</p></div></li><li class=\"flex items-start gap-3\"><span class=\"mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400 ring-1 ring-emerald-500/30\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-3.5 w-3.5\"><path d=\"M20 6 9 17l-5-5\"></path></svg></span><div><p class=\"text-sm font-semibold text-slate-200\">Reports &amp; Analytics</p><p class=\"text-xs text-slate-500\">Real-time KPIs, stock &amp; profit</p></div></li></ul><div class=\"mt-10 flex items-center gap-2 rounded-2xl border border-white/10 bg-white/[0.04] px-4 py-3 backdrop-blur\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"h-4 w-4 shrink-0\"><rect x=\"3\" y=\"11\" width=\"18\" height=\"11\" rx=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></p