{
  "name": "sccomm-web",
  "version": "0.1.0",
  "description": "CafeERP Enterprise Cyber Cafe & Retail ERP",
  "author": "Sarkar Communication",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "prebuild": "node scripts/restore-upi-workspace-build.mjs && node scripts/repair-dmt-build.mjs && node scripts/fix-day-close-build.mjs && node scripts/repair-settlement-money-build.mjs && node scripts/repair-settlement-cash-routing-build-v3.mjs && node scripts/repair-credit-card-repayment-build-v2.mjs && node scripts/repair-recharge-build.mjs && node scripts/repair-recharge-build-v2.mjs && node scripts/repair-business-edit-split-build.mjs && node scripts/repair-bill-payment-split-display-build.mjs && node scripts/repair-upi-reconciliation-cashout-build.mjs && node scripts/repair-upi-cashout-display-build.mjs && node scripts/repair-upi-qr-binding-build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-financial-invariants.mjs",
    "test:invariants": "node scripts/test-financial-invariants.mjs",
    "test:idempotency-client": "node scripts/test-client-idempotency-contract.mjs",
    "test:ai-browser": "node scripts/test-ai-browser-safety.mjs",
    "test:ai-learning": "node scripts/test-ai-learning-control.mjs",
    "start": "next start",
    "electron:dev": "electron electron/main.js",
    "dist:win": "electron-builder --win",
    "gateway": "node scripts/whatsapp-gateway.js",
    "ai:portal:teach": "node scripts/ai-portal-worker.mjs teach",
    "ai:portal:receipt-teach": "node scripts/ai-portal-receipt-teach.mjs",
    "ai:erp:aeps:teach": "node scripts/ai-erp-aeps-teach.mjs",
    "ai:aeps:run": "node scripts/ai-aeps-one-command-v3.mjs",
    "ai:portal:learn": "node scripts/ai-portal-worker.mjs learn",
    "ai:portal:collect": "node scripts/ai-portal-worker.mjs collect"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.46.1",
    "@types/qrcode": "^1.5.6",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "localtunnel": "^2.0.0",
    "lucide-react": "^1.39.0",
    "next": "^15.1.6",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.sarkarcommunication.cafeerp",
    "productName": "CafeERP",
    "directories": {"output": "dist-electron"},
    "files": ["electron/**/*", "public/**/*", "package.json"],
    "win": {"target": [{"target":"nsis","arch":["x64"]},{"target":"portable","arch":["x64"]}],"icon":"public/app-icon.png"},
    "nsis": {"oneClick":false,"allowToChangeInstallationDirectory":true,"createDesktopShortcut":true,"createStartMenuShortcut":true,"shortcutName":"CafeERP"}
  }
}
